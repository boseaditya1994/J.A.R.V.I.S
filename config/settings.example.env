# Copy this file to .env in the project root and fill in your own values.
# .env is gitignored — never commit real secrets.

# Assistant identity (configurable per the project brief)
JARVIS_NAME=JARVIS

# Anthropic API key — required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model routing: cheap/fast model for routine turns, stronger model for
# anything flagged as high-complexity. Names are current as of writing —
# check https://docs.anthropic.com/en/docs/about-claude/models for the
# latest if these ever 404.
LLM_MODEL_DEFAULT=claude-haiku-4-5-20251001
LLM_MODEL_COMPLEX=claude-sonnet-5

# Speech-to-text: faster-whisper model size (tiny/base/small/medium)
STT_MODEL=base

# Text-to-speech: any edge-tts voice name, e.g. en-US-GuyNeural,
# en-US-AriaNeural, en-GB-RyanNeural. List all with `edge-tts --list-voices`.
TTS_VOICE=en-US-GuyNeural

# Phase 8 proactive notifications: total notifications (morning brief +
# reminder nudges combined) allowed per UTC calendar day, across the
# scheduled jobs in jarvis/interfaces/proactive.py.
MAX_NOTIFICATIONS_PER_DAY=10

# Phase 9 multi-device server (jarvis/server/): only needed if you run
# `uvicorn jarvis.server.app:app`. Required for the server to start.
# API_AUTH_TOKEN: a long random secret the PWA sends as a Bearer token on
# every request — generate one with, e.g., `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`. Never reuse this anywhere else.
API_AUTH_TOKEN=
# VAPID_PRIVATE_KEY / VAPID_PUBLIC_KEY: the keypair proving JARVIS's server
# owns its push subscriptions (Web Push, no third-party notification
# service). Generate once with `uv run python -m jarvis.server.push` and
# paste both values here exactly as printed — bare base64url strings, no
# PEM headers/newlines (pywebpush's key parser only accepts the raw key,
# not PEM-armored text — a real bug found live, see push.py's docstring).
# Never regenerate after the PWA has subscribed, or existing subscriptions
# break.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
